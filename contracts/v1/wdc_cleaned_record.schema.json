{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommerceRadar Cleaned WDC Batch Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_schema_version",
    "dataset",
    "source_record_id",
    "cluster_id",
    "title",
    "brand",
    "category",
    "identifiers",
    "price",
    "currency",
    "price_parse_status",
    "quality_flags",
    "raw_record"
  ],
  "properties": {
    "batch_schema_version": {
      "const": "1.0"
    },
    "dataset": {
      "const": "wdc_english_v2_non_norm"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "cluster_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": [
        "array",
        "null"
      ]
    },
    "price": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "currency": {
      "enum": [
        null,
        "USD",
        "EUR",
        "GBP",
        "CAD",
        "AUD",
        "NZD",
        "JPY",
        "COP",
        "DKK",
        "EGP",
        "SAR",
        "AED"
      ]
    },
    "price_parse_status": {
      "enum": [
        "missing",
        "unsupported_type",
        "conflicting_currencies",
        "missing_amount",
        "multiple_amounts",
        "unknown_currency",
        "ambiguous_number_format",
        "negative_amount",
        "precision_or_separator_ambiguity",
        "parsed"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "enum": [
          "missing_title"
        ]
      },
      "uniqueItems": true
    },
    "raw_record": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "price_parse_status": {
            "const": "parsed"
          }
        }
      },
      "then": {
        "properties": {
          "price": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "price": {
            "type": "null"
          }
        }
      }
    }
  ]
}
