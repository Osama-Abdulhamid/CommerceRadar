{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommerceRadar Product Observation",
  "description": "A product offer observed at a specific source and time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "source",
    "source_product_id",
    "product_url",
    "title",
    "price",
    "currency",
    "availability"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Observation time in UTC, ending with Z."
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source_product_id": {
      "type": "string",
      "minLength": 1
    },
    "product_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
      "description": "Non-negative decimal price with two fractional digits."
    },
    "currency": {
      "type": "string",
      "enum": ["EGP", "USD", "EUR", "GBP", "SAR", "AED"],
      "description": "Currencies supported by this prototype."
    },
    "availability": {
      "type": "string",
      "enum": ["in_stock", "out_of_stock", "unknown"]
    },
    "brand": {
      "type": "string",
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
