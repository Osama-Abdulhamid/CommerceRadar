{
  "uid": "commerceradar-operations",
  "title": "CommerceRadar Operations",
  "description": "API scrape availability, request rate, errors, latency and process memory. Scrape health does not establish database or full-pipeline health.",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "commerceradar",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"commerceradar-api\"}",
          "legendFormat": "API scrape health",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(commerceradar_http_requests_total[5m]))",
          "legendFormat": "Requests per second",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Server errors per second",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(commerceradar_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "Server errors per second",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Requests by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(commerceradar_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "95th percentile request duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(commerceradar_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "95th percentile request duration",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "API process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "commerceradar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"commerceradar-api\"}",
          "legendFormat": "API process memory",
          "datasource": {
            "type": "prometheus",
            "uid": "commerceradar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
