# Docker Compose project name
COMPOSE_PROJECT_NAME=commerceradar

# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Data contract version
SCHEMA_VERSION=1.0

# Replay producer settings
REPLAY_INPUT_PATH=data/samples/product_observations.v1.jsonl
REPLAY_INTERVAL_SECONDS=1


# Kafka
KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=19092
KAFKA_TOPIC=product-observations.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Demo cluster ID; keep stable while reusing Kafka storage
KAFKA_CLUSTER_ID=GICp7Fc9S0ayxs1rx2G1sg

# Replay destination
REPLAY_OUTPUT=kafka

# HDFS local prototype
HADOOP_IMAGE=apache/hadoop:3.4.1
COMMERCE_DATA_ROOT=/mnt/e/CommerceRadarData
HDFS_STORAGE_ROOT=/mnt/e/CommerceRadarData/hdfs
HDFS_UI_PORT=9870

# ClickHouse — verified version 25.8.33.6
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server@sha256:0152dd511befe6a2c2ef53e930726179669b08116da78500b37c51c96ff5ee77
CLICKHOUSE_DB=commerceradar
CLICKHOUSE_USER=commerceradar

# Set your own password in .env before starting ClickHouse.
CLICKHOUSE_PASSWORD=

CLICKHOUSE_HTTP_PORT=18123

# Adjust this path for your machine.
