# Docker Compose project name
COMPOSE_PROJECT_NAME=commerceradar

# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Data contract version
SCHEMA_VERSION=1.0

# Replay producer settings
REPLAY_INPUT_PATH=data/samples/product_observations.v1.jsonl
REPLAY_INTERVAL_SECONDS=1


# Kafka
KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=19092
KAFKA_TOPIC=product-observations.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Demo cluster ID; keep stable while reusing Kafka storage
KAFKA_CLUSTER_ID=GICp7Fc9S0ayxs1rx2G1sg

# Replay destination
REPLAY_OUTPUT=kafka
